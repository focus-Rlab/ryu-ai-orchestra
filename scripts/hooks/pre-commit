#!/usr/bin/env bash
# Readable source copy of the main-branch commit guard. This file is NOT
# activated by pointing core.hooksPath here — that was tried first and found
# broken, because this path only exists in the working tree on branches
# where it has been committed, so it silently disappears on `main` itself
# (the one branch it must protect). See INCIDENT_LOG.md, "Independent review
# synthesis (2026-08-07)".
#
# The real installer is .claude/hooks/session-start.sh, which writes this
# same logic directly into .git/hooks/pre-commit (branch-independent) at the
# start of every Claude Code session. Keep the two copies identical by hand;
# manual clones can also copy this file to .git/hooks/pre-commit themselves.
#
# Root cause this closes: INCIDENT_LOG.md incident #1 (2026-07-26) and its
# 2026-08-07 recurrence. This hook runs on every `git commit` regardless of
# how it was invoked (direct, --amend, through an editor, through a GUI,
# through cherry-pick/revert/merge that ends in a commit) because git itself
# invokes it, not the caller.
set -euo pipefail

current_branch="$(git branch --show-current)"

if [ "$current_branch" = "main" ]; then
  echo "REFUSED (pre-commit hook): current branch is 'main'." >&2
  echo "Non-trivial changes must be committed on a dedicated branch (GOVERNANCE.md §13)." >&2
  echo "Create or switch to a working branch first, e.g.:" >&2
  echo "  git checkout -B <branch-name> origin/main" >&2
  exit 1
fi
